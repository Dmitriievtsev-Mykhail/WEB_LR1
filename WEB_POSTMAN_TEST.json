  "item": [
    {
      "name": "REGISTER",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code is 201 Created\", function () {\r",
              "    pm.response.to.have.status(201);\r",
              "});\r",
              "\r",
              "pm.test(\"Response contains valid email and id\", function () {\r",
              "    var jsonData = pm.response.json();\r",
              "    pm.expect(jsonData).to.have.property('email');\r",
              "    pm.expect(jsonData.email).to.eql(pm.environment.get(\"current_email\"));\r",
              "    pm.expect(jsonData).to.have.property('id');\r",
              "});\r",
              "\r",
              "pm.test(\"Response time is less than 1500ms\", function () {\r",
              "    pm.expect(pm.response.responseTime).to.be.below(1500);\r",
              "});"
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        },
        {
          "listen": "prerequest",
          "script": {
            "exec": [
              "const generatedEmail = pm.variables.replaceIn('{{$randomEmail}}');\r",
              "const generatedPassword = pm.variables.replaceIn('{{$randomPassword}}');\r",
              "\r",
              "pm.environment.set(\"current_email\", generatedEmail);\r",
              "pm.environment.set(\"current_password\", generatedPassword);"
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [],
        "body": {
          "mode": "raw",
          "raw": "{\r\n    \"email\": \"{{current_email}}\",\r\n    \"name\": \"{{$randomFullName}}\",\r\n    \"gender\": \"M\",\r\n    \"date_of_birth\": \"2000-01-01\",\r\n    \"password\": \"{{current_password}}\"\r\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "http://127.0.0.1:8000/api/auth/register/",
          "protocol": "http",
          "host": [
            "127",
            "0",
            "0",
            "1"
          ],
          "port": "8000",
          "path": [
            "api",
            "auth",
            "register",
            ""
          ]
        }
      },
      "response": []
